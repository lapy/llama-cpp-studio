# Reference for the environment consumed by compose.yaml. devcontrol writes the
# real values to ~/.local/state/llama-cpp-studio-dev/dev.env (mode 0600); this
# file is documentation, not a template copied into place.
#
# Never point DEV_DATA at the live instance's data directory and never use the
# production compose project name.

DEV_REPO=/home/studioagent/llama-cpp-studio-dev
DEV_CHECKOUT=/home/studioagent/llama-cpp-studio-dev
DEV_DATA=/home/studioagent/llama-cpp-studio-dev-data
DEV_SHARED_MODELS=/home/studioagent/llama-cpp-studio-shared-models
DEV_IMAGE=llama-cpp-studio:agent-dev
DEV_BASE_IMAGE=llama-cpp-studio:agent-dev-base
DEV_COMPOSE_PROJECT=llama-cpp-studio-dev
DEV_UID=1000
DEV_GID=1000

DEV_BACKEND_PORT=18081
DEV_FRONTEND_PORT=15173
DEV_PROXY_PORT=12000

# Empty disables GPU access. Comma-separated host device ids select devices.
DEV_GPU=
DEV_CUDA_VISIBLE_DEVICES=

# Generated by `devcontrol bootstrap`; do not reuse the live management token.
DEV_API_TOKEN=

# Optional PrimeUI license for the discarded base-image frontend build.
VITE_PRIMEUI_LICENSE=
